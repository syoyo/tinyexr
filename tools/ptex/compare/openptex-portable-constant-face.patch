+// Acquire load of a shared value.  Prefer this to a plain read of a
+// volatile object: volatile is not a C++ synchronization primitive, and a
+// pointer obtained through a volatile read can be mis-modelled by
+// optimizers (GCC 15 points-to analysis treats it as ANYTHING and then
+// loses the escape of other pointers returned from the same function).
+template <typename T>
+PTEX_INLINE T AtomicLoad(T volatile* target)
+{
+#ifdef PTEX_PLATFORM_WINDOWS
+    T value = *target;
+    MEM_FENCE();
+    return value;
+#else
+    return __atomic_load_n(const_cast<T*>(target), __ATOMIC_ACQUIRE);
+#endif
+}
