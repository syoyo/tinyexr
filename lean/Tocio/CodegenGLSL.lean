/-
  TinyEXR - Lean 4 formalization of the tocio GLSL codegen
  (`toc_codegen_glsl.c`).

  Ported 1:1 (scalar sources, no ACES 2.0 output transform) so the
  `tocio-glsl-diff` gate can compare generated shaders byte-for-byte:
  the decimal-float literal writer (`toc_sb_decfloat`), the version /
  precision / sampler header per target, the LUT texture descriptors and
  every per-op statement including the fixed-function styles.

  Out of scope: `TOC_OP_ACES_OUTPUT` (needs the precomputed `toc_aces2`
  parameter blob and its table emitter; the model reports UNSUPPORTED
  and the vectors never use it).

  Copyright (c) 2026 Syoyo Fujita and TinyEXR authors
  SPDX-License-Identifier: BSD-3-Clause
-/

import Tocio.CodegenC

namespace Tocio

set_option linter.unusedVariables false

/-! ## Decimal-float literals (`toc_sb_decfloat`) -/

/-- Signed decimal integer (`toc_sb_int`). -/
def decInt (i : Int) : String :=
  if i < 0 then "-" ++ toString (-i).toNat else toString i.toNat

/-- Normalize a positive double into `[1,10)`: repeated division by ten
(the C's loop, so the double rounding matches). -/
def decNormUp (v : Float) (e : Nat) : Float × Nat :=
  let rec go : Nat → Float → Nat → Float × Nat
    | 0, v, e => (v, e)
    | f + 1, v, e => if v >= 10.0 then go f (v / 10.0) (e + 1) else (v, e)
  go 400 v e

/-- Normalize a positive non-zero double into `[1,10)` by multiplying;
returns the value and the exponent magnitude. -/
def decNormDown (v : Float) (e : Nat) : Float × Nat :=
  let rec go : Nat → Float → Nat → Float × Nat
    | 0, v, e => (v, e)
    | f + 1, v, e => if v < 1.0 then go f (v * 10.0) (e + 1) else (v, e)
  go 400 v e

/-- `toc_sb_decfloat`: 9 significant digits with trailing zeros trimmed,
fixed notation for exponents in `[-4, 9)` and scientific otherwise. -/
def decFloat (fv : Float32) : String :=
  let v0 : Float := fv.toFloat
  if v0 != v0 then "0.0"
  else if v0 == 0.0 then "0.0"
  else
    let neg := v0 < 0.0
    let a := if neg then -v0 else v0
    if a > 3.0e38 then (if neg then "-3.4e38" else "3.4e38")
    else
      let (v1, eUp) := decNormUp a 0
      let (v2, eDown) := decNormDown v1 0
      let di0 := (v2 * 1.0e8 + 0.5).toUInt64.toNat
      let bumped := di0 >= 1000000000
      let di := if bumped then di0 / 10 else di0
      let e : Int := (eUp : Int) - (eDown : Int) + (if bumped then 1 else 0)
      let dig : List Nat :=
        (List.range 9).map (fun i => (di / 10 ^ (8 - i)) % 10)
      let digc0 := dig.reverse.dropWhile (· == 0) |>.length
      let digc := if digc0 == 0 then 1 else digc0
      let digCh (i : Nat) : Char := Char.ofNat ('0'.toNat + dig.getD i 0)
      let s := if neg then "-" else ""
      if e >= -4 && e < 9 then
        if e >= 0 then
          let n := e.toNat
          s ++ String.ofList ((List.range (n + 1)).map digCh) ++ "." ++
            (if n + 1 >= digc then "0"
             else String.ofList
               ((List.range (digc - (n + 1))).map (fun k => digCh (n + 1 + k))))
        else
          let zeros := (-e).toNat - 1
          s ++ "0." ++ String.ofList (List.replicate zeros '0') ++
            String.ofList ((List.range digc).map digCh)
      else
        s ++ String.ofList [digCh 0] ++ "." ++
          (if digc == 1 then "0"
           else String.ofList
             ((List.range (digc - 1)).map (fun k => digCh (1 + k)))) ++
          "e" ++ decInt e

/-! ## Shader structure -/

/-- A LUT texture descriptor (`toc_texture_desc`). -/
structure TexDesc where
  name : String
  dim : String
  width : Nat
  height : Nat
  depth : Nat
  channels : Nat
  interp : Bool
  deriving Repr

structure GLSLOut where
  source : String
  textures : List TexDesc

def emitF (b : UInt32) : String := decFloat (f32of b)

def emitVec3 (a b c : UInt32) : String :=
  "vec3(" ++ emitF a ++ "," ++ emitF b ++ "," ++ emitF c ++ ")"

def glslGcScale (lim thr power : Float32) : Float32 :=
  if lim <= 1.0 || thr >= 1.0 then 1.0
  else
    let ip : Float32 := 1.0 / power
    let t : Float32 := (lim - thr) / (1.0 - thr)
    let d : Float32 := powf (powf t power - 1.0) ip
    if d != 0.0 then (lim - thr) / d else 1.0

/-- Target header (`toc_glsl_target`). -/
def glslHeader (target : String) : String :=
  let ver := if target == "es30" then "300 es"
             else if target == "330" then "330" else "450"
  "#version " ++ ver ++ "\n" ++
  (if target == "es30" then "precision highp float;\nprecision highp sampler3D;\n" else "") ++
  "// Generated by tocio. SPDX-License-Identifier: BSD-3-Clause\n" ++
  "// Color pipeline reimplemented from OpenColorIO (BSD-3-Clause).\n"

/-- The C's ACES Red-Mod / Gamut-Comp trigger. -/
def needsGlslAces (op : COp) : Bool :=
  match op with
  | .fixed style .. => (style >= 10 && style <= 13) || style == 4 || style == 5
  | _ => false

def fixedIs (s : Nat) (op : COp) : Bool :=
  match op with
  | .fixed style .. => style == s
  | _ => false

/-! ## Per-op emission (`vec4 v`) -/

def glslOp (texIdx : Nat) (op : COp) : Except String (String × Nat) :=
  match op with
  | .matrix m off =>
    let mats := String.intercalate "," ((List.range 16).map (fun i => emitF (fget m i)))
    .ok ("  v = mat4(" ++ mats ++ ") * v + vec4(" ++
      emitF (fget off 0) ++ "," ++ emitF (fget off 1) ++ "," ++
      emitF (fget off 2) ++ "," ++ emitF (fget off 3) ++ ");\n", texIdx)
  | .range scale offset lo hi cl hi' =>
    let s := "  v = v * vec4(" ++
      String.intercalate "," ((List.range 4).map (fun i => emitF (fget scale i))) ++
      ") + vec4(" ++
      String.intercalate "," ((List.range 4).map (fun i => emitF (fget offset i))) ++
      ");\n"
    if cl || hi' then
      let mn := if cl then fget lo 0 else fbits (1.0e30 : Float32)
      let mx := if hi' then fget hi 0 else fbits (1.0e30 : Float32)
      .ok (s ++ "  v = clamp(v, vec4(" ++ emitF mn ++ "), vec4(" ++ emitF mx ++ "));\n",
        texIdx)
    else .ok (s, texIdx)
  | .exponent e mirror =>
    .ok ("  v.rgb = " ++
      (if mirror then "sign(v.rgb) * pow(abs(v.rgb), "
       else "pow(max(v.rgb, vec3(0.0)), ") ++
      emitVec3 (fget e 0) (fget e 1) (fget e 2) ++ ");\n", texIdx)
  | .log ls lo ns no base inv =>
    if !inv then
      .ok ("  v.rgb = " ++ emitVec3 (fget ls 0) (fget ls 1) (fget ls 2) ++
        " * log2(" ++ emitVec3 (fget ns 0) (fget ns 1) (fget ns 2) ++
        " * v.rgb + " ++ emitVec3 (fget no 0) (fget no 1) (fget no 2) ++
        ") / log2(" ++ emitF base ++ ") + " ++
        emitVec3 (fget lo 0) (fget lo 1) (fget lo 2) ++ ";\n", texIdx)
    else
      .ok ("  v.rgb = (pow(vec3(" ++ emitF base ++ "), (v.rgb - " ++
        emitVec3 (fget lo 0) (fget lo 1) (fget lo 2) ++ ") / " ++
        emitVec3 (fget ls 0) (fget ls 1) (fget ls 2) ++ ") - " ++
        emitVec3 (fget no 0) (fget no 1) (fget no 2) ++ ") / " ++
        emitVec3 (fget ns 0) (fget ns 1) (fget ns 2) ++ ";\n", texIdx)
  | .expLinear sc of gm bk sl inv mir =>
    let pre := if mir then "  { vec3 _s = sign(v.rgb); v.rgb = abs(v.rgb);\n" else ""
    let post := if mir then "  v.rgb *= _s; }\n" else ""
    let body :=
      if !inv then
        "  v.rgb = mix(v.rgb * " ++ emitVec3 (fget sl 0) (fget sl 1) (fget sl 2) ++
          ", pow(v.rgb * " ++ emitVec3 (fget sc 0) (fget sc 1) (fget sc 2) ++
          " + " ++ emitVec3 (fget of 0) (fget of 1) (fget of 2) ++ ", " ++
          emitVec3 (fget gm 0) (fget gm 1) (fget gm 2) ++ "), greaterThan(v.rgb, " ++
          emitVec3 (fget bk 0) (fget bk 1) (fget bk 2) ++ "));\n"
      else
        let g0 := fbits ((1.0 : Float32) / f32of (fget gm 0))
        let g1 := fbits ((1.0 : Float32) / f32of (fget gm 1))
        let g2 := fbits ((1.0 : Float32) / f32of (fget gm 2))
        let b0 := fbits (f32of (fget bk 0) * f32of (fget sl 0))
        let b1 := fbits (f32of (fget bk 1) * f32of (fget sl 1))
        let b2 := fbits (f32of (fget bk 2) * f32of (fget sl 2))
        "  v.rgb = mix(v.rgb / " ++ emitVec3 (fget sl 0) (fget sl 1) (fget sl 2) ++
          ", (pow(v.rgb, " ++ emitVec3 g0 g1 g2 ++ ") - " ++
          emitVec3 (fget of 0) (fget of 1) (fget of 2) ++ ") / " ++
          emitVec3 (fget sc 0) (fget sc 1) (fget sc 2) ++ ", greaterThan(v.rgb, " ++
          emitVec3 b0 b1 b2 ++ "));\n"
    .ok (pre ++ body ++ post, texIdx)
  | .cdl slope off power sat luma clamp inv =>
    let zeroLuma := isZero (fget luma 0) && isZero (fget luma 1) && isZero (fget luma 2)
    let lr := if zeroLuma then fbits (0.2126 : Float32) else fget luma 0
    let lg := if zeroLuma then fbits (0.7152 : Float32) else fget luma 1
    let lb := if zeroLuma then fbits (0.0722 : Float32) else fget luma 2
    if inv then
      let invSat := if !isZero sat then fbits ((1.0 : Float32) / f32of sat)
                    else fbits (0.0 : Float32)
      let ip (i : Nat) : UInt32 :=
        if isZero (fget power i) then fbits (1.0 : Float32)
        else fbits ((1.0 : Float32) / f32of (fget power i))
      let isl (i : Nat) : UInt32 :=
        if isZero (fget slope i) then fbits (1.0 : Float32)
        else fbits ((1.0 : Float32) / f32of (fget slope i))
      .ok ("  { vec3 c = v.rgb;\n  float L = dot(c, " ++
        emitVec3 lr lg lb ++ ");\n  c = L + (c - L) * " ++ emitF invSat ++ ";\n" ++
        (if clamp then "  c = clamp(c, 0.0, 1.0);\n" else "") ++
        "  c = pow(c, " ++ emitVec3 (ip 0) (ip 1) (ip 2) ++ ");\n  c = (c - " ++
        emitVec3 (fget off 0) (fget off 1) (fget off 2) ++ ") * " ++
        emitVec3 (isl 0) (isl 1) (isl 2) ++ ";\n  v.rgb = c; }\n", texIdx)
    else
      .ok ("  { vec3 c = v.rgb * " ++
        emitVec3 (fget slope 0) (fget slope 1) (fget slope 2) ++ " + " ++
        emitVec3 (fget off 0) (fget off 1) (fget off 2) ++ ";\n" ++
        (if clamp then "  c = clamp(c, 0.0, 1.0);\n" else "") ++
        "  c = pow(c, " ++
        emitVec3 (fget power 0) (fget power 1) (fget power 2) ++ ");\n" ++
        "  float L = dot(c, " ++ emitVec3 lr lg lb ++ ");\n  c = L + " ++
        emitF sat ++ " * (c - L);\n" ++
        (if clamp then "  c = clamp(c, 0.0, 1.0);\n" else "") ++
        "  v.rgb = c; }\n", texIdx)
  | .lut1d len ch dmin dmax _ =>
    let comp := ["r", "g", "b"]
    let nMinus := fbits ((len - 1).toFloat.toFloat32)
    let nF := fbits (len.toFloat.toFloat32)
    let dm := fbits (f32of dmax - f32of dmin)
    let one (c : Nat) : String :=
      let cn := comp.getD c "r"
      "  v." ++ cn ++ " = texture(ociolut" ++ toString texIdx ++
        ", vec2((clamp((v." ++ cn ++ " - " ++ emitF dmin ++ ") / " ++ emitF dm ++
        ", 0.0, 1.0) * " ++ emitF nMinus ++ " + 0.5) / " ++ emitF nF ++
        ", 0.5))." ++ (if ch == 1 then "r" else cn) ++ ";\n"
    .ok (String.join ((List.range 3).map one), texIdx + 1)
  | .lut3d size dmin dmax _ _ =>
    let nMinus := fbits ((size - 1).toFloat.toFloat32)
    let nF := fbits (size.toFloat.toFloat32)
    let dm (i : Nat) : UInt32 := fbits (f32of (fget dmax i) - f32of (fget dmin i))
    .ok ("  { vec3 u = clamp((v.rgb - " ++
      emitVec3 (fget dmin 0) (fget dmin 1) (fget dmin 2) ++ ") / " ++
      emitVec3 (dm 0) (dm 1) (dm 2) ++ ", 0.0, 1.0);\n  v.rgb = texture(ociolut" ++
      toString texIdx ++ ", (u * " ++ emitF nMinus ++ " + 0.5) / " ++ emitF nF ++
      ").rgb; }\n", texIdx + 1)
  | .fixed style nparams p =>
    let h (s : String) : Except String (String × Nat) := .ok (s, texIdx)
    if style == 6 || style == 7 then
      let g := f32of (fget p 0)
      let e := if style == 6 then fbits (g - 1.0) else fbits ((1.0 / g) - 1.0)
      h ("  { float Y = 0.2627*v.r+0.6780*v.g+0.0593*v.b;\n  float s = Y>0.0?pow(Y," ++
        emitF e ++ "):0.0;\n  v.rgb *= s; }\n")
    else if style == 8 || style == 0 then
      let gg := fget p 0
      let gm := fget p 1
      h ("  { float YC=(v.r+v.g+v.b+1.75*sqrt(max(v.b*(v.b-v.g)+v.g*(v.g-v.r)+v.r*(v.r-v.b),0.0)))/3.0;\n" ++
        "  float mn=min(v.r,min(v.g,v.b));float mx=max(v.r,max(v.g,v.b));\n" ++
        "  float sat=(max(1e-10,mx)-max(1e-10,mn))/max(0.01,mx);\n" ++
        "  float x=(sat-0.4)*5.0;float sg=sign(x);float t=max(0.0,1.0-0.5*sg*x);\n" ++
        "  float s=(1.0+sg*(1.0-t*t))*0.5;\n  float GG=" ++ emitF gg ++ "*s;\n" ++
        "  float go;\n  if(YC>= " ++
        emitF (fbits (f32of gm * 2.0)) ++ ")go=0.0;\n  else if(YC<= " ++
        emitF (fbits (f32of gm * 2.0 / 3.0)) ++ ")go=GG;\n  else go=GG*(" ++
        emitF gm ++ "/YC-0.5);\n  v.rgb *= 1.0+go; }\n")
    else if style == 9 || style == 1 then
      let gg := fget p 0
      let gm := fget p 1
      h ("  { float YC=(v.r+v.g+v.b+1.75*sqrt(max(v.b*(v.b-v.g)+v.g*(v.g-v.r)+v.r*(v.r-v.b),0.0)))/3.0;\n" ++
        "  float mn=min(v.r,min(v.g,v.b));float mx=max(v.r,max(v.g,v.b));\n" ++
        "  float sat=(max(1e-10,mx)-max(1e-10,mn))/max(0.01,mx);\n" ++
        "  float x=(sat-0.4)*5.0;float sg=sign(x);float t=max(0.0,1.0-0.5*sg*x);\n" ++
        "  float s=(1.0+sg*(1.0-t*t))*0.5;\n  float GG=" ++ emitF gg ++ "*s;\n" ++
        "  float go;\n  if(YC>= " ++
        emitF (fbits (f32of gm * 2.0)) ++ ")go=0.0;\n  else if(YC<= " ++
        emitF (fbits ((1.0 + f32of gg) * f32of gm * 2.0 / 3.0)) ++
        ")go=-GG/(1.0+GG);\n  else go=GG*(" ++
        emitF gm ++ "/YC-0.5)/(GG*0.5-1.0);\n  v.rgb *= 1.0+go; }\n")
    else if style == 2 then
      h ("  { float Y=max(1e-10,0.27222872*v.r+0.67408177*v.g+0.05368952*v.b);\n" ++
        "  v.rgb *= pow(Y," ++ emitF (fbits (f32of (fget p 0) - 1.0)) ++ "); }\n")
    else if style == 3 then
      h ("  { float Y=max(1e-10,0.27222872*v.r+0.67408177*v.g+0.05368952*v.b);\n" ++
        "  v.rgb *= pow(Y," ++ emitF (fbits ((1.0 : Float32) / f32of (fget p 0) - 1.0)) ++ "); }\n")
    else if style >= 10 && style <= 13 then
      let is03 := style == 10 || style == 11
      let inv := style == 11 || style == 13
      h ("  v.rgb = tocRedmod(v.rgb, " ++
        emitF (fbits (if is03 then (0.85 : Float32) else (0.82 : Float32))) ++
        ", 0.03, " ++
        emitF (fbits (if is03 then (1.9098593171027443 : Float32)
                      else (1.6976527263135504 : Float32))) ++
        (if inv then ", true);\n" else ", false);\n"))
    else if style == 4 || style == 5 then
      let pw := f32of (fget p 6)
      let inv := style == 5
      h ("  v.rgb = tocGamutComp(v.rgb, vec3(" ++
        emitF (fget p 3) ++ "," ++ emitF (fget p 4) ++ "," ++ emitF (fget p 5) ++
        "), vec3(" ++
        emitF (fbits (glslGcScale (f32of (fget p 0)) (f32of (fget p 3)) pw)) ++ "," ++
        emitF (fbits (glslGcScale (f32of (fget p 1)) (f32of (fget p 4)) pw)) ++ "," ++
        emitF (fbits (glslGcScale (f32of (fget p 2)) (f32of (fget p 5)) pw)) ++
        "), " ++ emitF (fget p 6) ++ (if inv then ", true);\n" else ", false);\n"))
    else if style == 14 then
      h ("  { float mn=min(v.r,min(v.g,v.b));float mx=max(v.r,max(v.g,v.b));\n" ++
        "  float h=0,s=0,vv=mx;if(mn!=mx){float d=mx-mn;\n" ++
        "  if(mx!=0.0)s=d/mx;\n" ++
        "  if(v.r==mx)h=(v.g-v.b)/d;else if(v.g==mx)h=2.0+(v.b-v.r)/d;else h=4.0+(v.r-v.g)/d;\n" ++
        "  if(h<0)h+=6.0;h*=0.16666667;}\n" ++
        "  if(mn<0)vv+=mn;if(-mn>mx)s=(mx-mn)/-mn;\n" ++
        "  v=vec4(h,s,vv,v.a);}\n")
    else if style == 15 then
      h ("  { float h=(v.r-floor(v.r))*6.0,s=clamp(v.g,0.0,1.999),vv=v.b;\n" ++
        "  float rp=clamp(abs(h-3.0)-1.0,0.0,1.0);\n" ++
        "  float gp=1.0-clamp(abs(h-2.0),0.0,1.0);\n" ++
        "  float bp=1.0-clamp(abs(h-4.0),0.0,1.0);\n" ++
        "  float mx=vv,mn=vv*(1.0-s);\n" ++
        "  if(s>1.0){mn=vv*(1.0-s)/(2.0-s);mx=vv-mn;}\n" ++
        "  if(vv<0.0){mn=vv/(2.0-s);mx=vv-mn;}float d=mx-mn;\n" ++
        "  v=vec4(rp*d+mn,gp*d+mn,bp*d+mn,v.a);}\n")
    else if style == 16 then
      h ("  { float d=1.0/max(v.r+v.g+v.b,1e-10);v=vec4(v.r*d,v.g*d,v.b,v.a);}\n")
    else if style == 17 then
      h ("  { float d=1.0/max(v.g,1e-10);\n" ++
        "  v=vec4(v.b*v.r*d,v.b,v.b*(1.0-v.r-v.g)*d,v.a);}\n")
    else if style == 18 then
      h ("  { float d=1.0/max(v.r+15.0*v.g+3.0*v.b,1e-10);\n" ++
        "  v=vec4(4.0*v.r*d,9.0*v.g*d,v.b,v.a);}\n")
    else if style == 19 then
      h ("  { float d=1.0/max(v.g,1e-10);\n" ++
        "  v=vec4(2.25*v.b*v.r*d,v.b,0.75*v.b*(4.0-v.r-6.66667*v.g)*d,v.a);}\n")
    else if style == 20 then
      h ("  { float d=1.0/max(v.r+15.0*v.g+3.0*v.b,1e-10);\n" ++
        "  float u=4.0*v.r*d,vv=9.0*v.g*d;\n" ++
        "  float ls=v.b<=0.008856?9.03296*v.b:1.16*pow(v.b,0.33333)-0.16;\n" ++
        "  v=vec4(ls,13.0*ls*(u-0.19783),13.0*ls*(vv-0.46832),v.a);}\n")
    else if style == 21 then
      h ("  { float d=0.076923/max(v.r,1e-10);\n" ++
        "  float u=v.g*d+0.19783,vv=v.b*d+0.46832;\n" ++
        "  float t=(v.r+0.16)*0.862069;\n" ++
        "  float Y=v.r<=0.08?0.110706*v.r:t*t*t;\n" ++
        "  float dd=0.25/max(vv,1e-10);\n" ++
        "  v=vec4(9.0*Y*u*dd,Y,Y*(12.0-3.0*u-20.0*vv)*dd,v.a);}\n")
    else if style == 22 then
      h ("  { vec3 Lm=pow(max(v.rgb,0.0)*0.01,vec3(0.1593017578125));\n" ++
        "  v.rgb=pow((0.8359375+18.8515625*Lm)/(1.0+18.6875*Lm),vec3(78.84375)); }\n")
    else if style == 23 then
      h ("  { vec3 Np=pow(max(v.rgb,0.0),vec3(0.012683313));\n" ++
        "  vec3 nu=max(Np-0.8359375,0.0),de=max(18.8515625-18.6875*Np,1e-10);\n" ++
        "  v.rgb=pow(nu/de,vec3(6.2773438))*100.0; }\n")
    else if style == 24 then
      h ("  { vec3 e=max(v.rgb,0.0);\n" ++
        "  v.rgb=mix(0.17883277*log(max(12.0*e-0.28466892,1e-10))+0.55991073,\n" ++
        "            sqrt(3.0*e), lessThanEqual(e,vec3(0.083333333))); }\n")
    else if style == 25 then
      h ("  { v.rgb=mix((exp((v.rgb-0.55991073)/0.17883277)+0.28466892)/12.0,\n" ++
        "            v.rgb*v.rgb/3.0, lessThanEqual(v.rgb,vec3(0.5))); }\n")
    else h ""
  | .logCamera .. | .aces2 .. => .ok ("", texIdx)

/-- `toc_emit_glsl` for the modelled op kinds. -/
def emitGLSL (target : String) (ops : List COp) : Except String GLSLOut :=
  let vulkan := target == "vulkan"
  let header := glslHeader target
  let samplers : String :=
    let rec samplerGo : Nat → List COp → String
      | _, [] => ""
      | idx, op :: rest =>
        match op with
        | .lut1d .. | .lut3d .. =>
          let styp := match op with
            | .lut3d .. => "sampler3D"
            | _ => "sampler2D"
          (if vulkan then "layout(binding=" ++ toString idx ++ ") " else "") ++
            "uniform " ++ styp ++ " ociolut" ++ toString idx ++ ";\n" ++
            samplerGo (idx + 1) rest
        | _ => samplerGo idx rest
    samplerGo 0 ops
  let texDescs : List TexDesc :=
    let luts := ops.filterMap (fun op =>
      match op with
      | .lut1d len ch _ _ _ => some (true, len, ch)
      | .lut3d size .. => some (false, size, 3)
      | _ => none)
    (List.zip (List.range luts.length) luts).map (fun (i, (is1d, n, ch)) =>
      { name := "ociolut" ++ toString i
        dim := if is1d then "2D" else "3D"
        width := n
        height := if is1d then 1 else n
        depth := if is1d then 1 else n
        channels := if is1d then (if ch == 1 then 1 else 3) else 3
        interp := true })
  let acesSrc := if ops.any needsGlslAces then GLSL_ACES_SRC else ""
  let bodyOps :=
    let rec bodyGo (texIdx : Nat) : List COp → Except String (String × Nat)
      | [] => .ok ("", texIdx)
      | op :: rest =>
        (glslOp texIdx op).bind (fun (s, t1) =>
          (bodyGo t1 rest).map (fun (t, t2) => (s ++ t, t2)))
    bodyGo 0 ops
  bodyOps.map (fun (body, _) =>
    { source := header ++ samplers ++ acesSrc ++
        "vec4 OCIOMain(vec4 inPixel){\n  vec4 v = inPixel;\n" ++ body ++
        "  return v;\n}\n"
      textures := texDescs })

end Tocio
